# Todo lo que sale del disco del usuario se queda en su equipo: no se sube ni se distribuye.

# Archivos del juego (extraídos del disco) e imágenes de disco
extracted/
*.bin
*.cue
*.iso
*.img

# Compilación: el C recompilado (build/gen) y los binarios son traducción del ejecutable del juego
build/
web/x4.js
web/x4.wasm

# HD con IA: piezas generadas a partir de los gráficos del juego
hd_pack/
hd_queue/
hd_captures/
hd_preview/

# Voces en español: guion traducido del texto del juego y audios generados a partir de él
voice_lines/
voice_pack/

# Partidas guardadas (tarjeta de memoria)
*.mcr

# Python, macOS, editores
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/
